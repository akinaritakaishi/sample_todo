{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm --prefix front run lint)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Bash(cat *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(less *.env)",
      "Bash(more *.env)",
      "Bash(cat *.env.local)",
      "Bash(head *.env.local)",
      "Bash(tail *.env.local)",
      "Bash(less *.env.local)",
      "Bash(more *.env.local)",
      "Bash(cat *.env.*.local)",
      "Bash(head *.env.*.local)",
      "Bash(tail *.env.*.local)",
      "Bash(less *.env.*.local)",
      "Bash(more *.env.*.local)",
      "Bash(cat *.env.development)",
      "Bash(head *.env.development)",
      "Bash(tail *.env.development)",
      "Bash(less *.env.development)",
      "Bash(more *.env.development)",
      "Bash(cat *.env.production)",
      "Bash(head *.env.production)",
      "Bash(tail *.env.production)",
      "Bash(less *.env.production)",
      "Bash(more *.env.production)",
      "Bash(cat *.env.staging)",
      "Bash(head *.env.staging)",
      "Bash(tail *.env.staging)",
      "Bash(less *.env.staging)",
      "Bash(more *.env.staging)",
      "Bash(cat *.env.test)",
      "Bash(head *.env.test)",
      "Bash(tail *.env.test)",
      "Bash(less *.env.test)",
      "Bash(more *.env.test)",
      "Bash(git push *--force*)",
      "Bash(git push *--force-with-lease*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * +*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm --recursive --force *)",
      "Bash(rm --force --recursive *)"
    ]
  }
}
